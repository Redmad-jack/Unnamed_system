# LLM configuration
# Shell environment variables override values in this file.
#
# Important:
# 1. At any time, enable only ONE provider block below.
# 2. When switching providers, keep the other provider block commented out.
# 3. If your shell already exported old LLM variables, restart the terminal or unset them.

# Shared runtime settings
ENTITY_DB_PATH=data/memory.db
ENTITY_CONFIG_DIR=config/
ENTITY_PROMPTS_DIR=prompts/
ENTITY_LOG_LEVEL=INFO
ENTITY_LLM_DISABLE_SYSTEM_PROXY=1

# --------------------------------------------------------------------
# Provider A: Official Anthropic
# Enable this block by uncommenting the line below.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_official_key_here

# --------------------------------------------------------------------
# Provider B: Anthropic-compatible gateway (e.g. newcli / FoxCode)
# Enable this block by uncommenting the three lines below.
# --------------------------------------------------------------------
# ANTHROPIC_AUTH_TOKEN=your_supplier_token_here
# ANTHROPIC_BASE_URL=https://code.newcli.com/claude/aws
# ENTITY_LLM_MODEL=claude-sonnet-4-5

# --------------------------------------------------------------------
# Provider C: AIHubMix / non-standard gateway
# Preferred mode: Anthropic-compatible base_url.
# Enable this block by uncommenting the three lines below.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_aihubmix_key_here
# ANTHROPIC_BASE_URL=https://aihubmix.com
# ENTITY_LLM_MODEL=claude-haiku-4-5

# --------------------------------------------------------------------
# Provider C alternate: full POST messages endpoint
# Use this only if the selected model works better through the full
# messages endpoint instead of base_url mode.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_aihubmix_key_here
# ENTITY_LLM_MESSAGES_ENDPOINT=https://aihubmix.com/v1/messages
# ENTITY_LLM_MODEL=your_model_name_here

# Optional embedding retrieval mode.
# Disabled keeps deterministic memory retrieval only.
ENTITY_EMBEDDING_MODE=disabled
# ENTITY_EMBEDDING_MODE=openai_compatible
# ENTITY_EMBEDDING_MODEL=text-embedding-3-small
# ENTITY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ENTITY_EMBEDDING_API_KEY=your_embedding_key_here
# Optional full embeddings endpoint. If set, it overrides ENTITY_EMBEDDING_BASE_URL + /embeddings.
# ENTITY_EMBEDDING_ENDPOINT=https://your-provider.example/v1/embeddings

# Operator panel authentication (v0.2)
# OPERATOR_API_KEY=your_secret_here

# Database
ENTITY_DB_PATH=data/memory.db

# Config directories
ENTITY_CONFIG_DIR=config/
ENTITY_PROMPTS_DIR=prompts/

# Logging
ENTITY_LOG_LEVEL=INFO

# Operator panel authentication (v0.2)
# OPERATOR_API_KEY=your_secret_here
