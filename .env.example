# LLM configuration
# Shell environment variables override values in this file.
#
# Important:
# 1. At any time, enable only ONE provider block below.
# 2. When switching providers, keep the other provider block commented out.
# 3. If your shell already exported old LLM variables, restart the terminal or unset them.

# Shared runtime settings
ENTITY_DB_PATH=data/memory.db
ENTITY_CONFIG_DIR=config/
ENTITY_PROMPTS_DIR=prompts/
ENTITY_LOG_LEVEL=INFO
ENTITY_LLM_DISABLE_SYSTEM_PROXY=1

# --------------------------------------------------------------------
# Provider A: Official Anthropic
# Enable this block by uncommenting the line below.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_official_key_here

# --------------------------------------------------------------------
# Provider B: Anthropic-compatible gateway (e.g. newcli / FoxCode)
# Enable this block by uncommenting the three lines below.
# --------------------------------------------------------------------
# ANTHROPIC_AUTH_TOKEN=your_supplier_token_here
# ANTHROPIC_BASE_URL=https://code.newcli.com/claude/aws
# ENTITY_LLM_MODEL=claude-sonnet-4-5

# --------------------------------------------------------------------
# Provider C: AIHubMix / non-standard gateway
# Preferred mode: Anthropic-compatible base_url.
# Enable this block by uncommenting the three lines below.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_aihubmix_key_here
# ANTHROPIC_BASE_URL=https://aihubmix.com
# ENTITY_LLM_MODEL=claude-haiku-4-5

# --------------------------------------------------------------------
# Provider C alternate: full POST messages endpoint
# Use this only if the selected model works better through the full
# messages endpoint instead of base_url mode.
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_aihubmix_key_here
# ENTITY_LLM_MESSAGES_ENDPOINT=https://aihubmix.com/v1/messages
# ENTITY_LLM_MODEL=your_model_name_here

# Optional embedding retrieval mode.
# Disabled keeps deterministic memory retrieval only.
ENTITY_EMBEDDING_MODE=disabled
# ENTITY_EMBEDDING_MODE=openai_compatible
# ENTITY_EMBEDDING_MODEL=text-embedding-3-small
# ENTITY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ENTITY_EMBEDDING_API_KEY=your_embedding_key_here
# Optional full embeddings endpoint. If set, it overrides ENTITY_EMBEDDING_BASE_URL + /embeddings.
# ENTITY_EMBEDDING_ENDPOINT=https://your-provider.example/v1/embeddings

# Optional vision runtime.
# Requires optional dependencies: pip install -e ".[api,vision]"
# The model must be a local YOLO model path. The app does not download models.
# ENTITY_VISION_MODEL_PATH=/absolute/path/to/yolo-model.pt
ENTITY_VISION_CAMERA_INDEX=0
ENTITY_VISION_WIDTH=1280
ENTITY_VISION_HEIGHT=720
ENTITY_VISION_FPS=10
ENTITY_VISION_CONFIDENCE=0.45
ENTITY_VISION_ENTER_FRAMES=3
ENTITY_VISION_LEAVE_SECONDS=2.0
ENTITY_VISION_SILENCE_SECONDS=45.0

# Optional audio runtime.
# Requires optional dependencies: pip install -e ".[api,audio]"
# Voice is an adapter layer: STT final transcripts enter the normal turn loop,
# and TTS only speaks final ExpressionOutput-derived stream ids.
ENTITY_AUDIO_PROVIDER=disabled
ENTITY_AUDIO_ENABLED=0
ENTITY_VOLCENGINE_AUTH_MODE=api_key
# ENTITY_VOLCENGINE_API_KEY=your_volcengine_api_key_here
# ENTITY_VOLCENGINE_APP_ID=your_legacy_app_id_here
# ENTITY_VOLCENGINE_ACCESS_TOKEN=your_legacy_access_token_here
ENTITY_VOLCENGINE_STT_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ENTITY_VOLCENGINE_STT_RESOURCE_ID=volc.seedasr.sauc.concurrent
ENTITY_AUDIO_SAMPLE_RATE=16000
ENTITY_AUDIO_CHUNK_MS=200
ENTITY_VOLCENGINE_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
ENTITY_VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
# ENTITY_VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
# ENTITY_VOLCENGINE_TTS_VOICE_TYPE=your_volcengine_voice_type_here
# ENTITY_VOLCENGINE_TTS_ZH_VOICE_TYPE=your_chinese_clone_voice_id_here
# ENTITY_VOLCENGINE_TTS_EN_VOICE_TYPE=your_english_clone_voice_id_here
ENTITY_AUDIO_OUTPUT_FORMAT=mp3
ENTITY_AUDIO_TTS_SAMPLE_RATE=24000
ENTITY_AUDIO_TTS_MAX_SEGMENT_BYTES=800
ENTITY_AUDIO_TTS_STREAM_TTL_SECONDS=120
ENTITY_AUDIO_MAX_ACTIVE_SESSIONS=4
ENTITY_AUDIO_QUEUE_MAX_CHUNKS=8
ENTITY_AUDIO_ALLOW_DEBUG_RAW_TTS=0

# Operator panel authentication (v0.2)
# OPERATOR_API_KEY=your_secret_here

# --------------------------------------------------------------------
# Optional online public /arts deployment.
# Render backend + Netlify static frontend. Public mode protects the
# dashboard, docs, memory/debug/config routes and non-public WebSockets
# with OPERATOR_API_KEY while keeping /health and /api/v1/public open.
# --------------------------------------------------------------------
ONLINE_PUBLIC_MODE=0
# STRANGER_PUBLIC_ACCESS_CODE=shared_public_access_code_here
# STRANGER_PUBLIC_TOKEN_SECRET=separate_session_token_secret_here
# STRANGER_PUBLIC_ALLOWED_ORIGINS=https://your-netlify-site.netlify.app
# STRANGER_PUBLIC_MAX_INPUT_CHARS=900
# STRANGER_PUBLIC_TURN_LIMIT_PER_MINUTE=12
# STRANGER_PUBLIC_STT_CONNECTIONS_PER_MINUTE=6
# STRANGER_PUBLIC_SESSION_TTL_SECONDS=21600
# STRANGER_RENDER_BASE_URL=https://your-render-service.onrender.com
